.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ===== 日志 =====
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 依赖 =====
node_modules/
vendor/
__pycache__/
*.py[cod]
.venv/
venv/
env/

